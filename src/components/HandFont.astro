---
// Il font "a mano" dei titoli (Beth Ellen), da mettere nel <head>.
// Lo dichiariamo qui invece di usare il CSS di @fontsource, che ha
// font-display: swap e quindi mostra prima un carattere di riserva e poi lo
// sostituisce (l'effetto "font sbagliato" che si vedeva aprendo il sito).
// Con `block` il testo aspetta il suo font; il preload lo fa partire subito e
// /_astro/* resta in cache per un anno (vedi public/_headers).
import bethEllenWoff2 from '@fontsource/beth-ellen/files/beth-ellen-latin-400-normal.woff2?url';

const fontFace = `@font-face{font-family:'Beth Ellen';font-style:normal;font-weight:400;font-display:block;src:url(${bethEllenWoff2}) format('woff2');unicode-range:U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD}`;
---

<link rel="preload" href={bethEllenWoff2} as="font" type="font/woff2" crossorigin />
<style is:inline set:html={fontFace}></style>
