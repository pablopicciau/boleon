---
import HandFont from '../components/HandFont.astro';
import '../styles/global.css';
import settings from '../lib/settings';
import LanguageSwitcher from '../components/LanguageSwitcher.astro';
import {
  defaultLocale,
  localeMeta,
  locales,
  localizePath,
  pickLocalized,
  switchLocalePath,
  useTranslations,
  type Locale,
} from '../i18n';

interface Props {
  locale: Locale;
  title?: string;
  description?: string;
  /** Immagine per le anteprime social (percorso relativo o assoluto). */
  ogImage?: string;
  ogType?: 'website' | 'article' | 'product';
  /** Dati strutturati schema.org (JSON-LD) per motori di ricerca e AI. */
  schema?: Record<string, unknown> | Record<string, unknown>[];
  /**
   * false = pagina senza versioni nelle altre lingue (es. la 404): niente
   * hreflang, niente salto automatico di lingua, lo switcher porta alle home.
   */
  localized?: boolean;
  /** Chiede ai motori di ricerca di non indicizzare la pagina. */
  noindex?: boolean;
}

const {
  locale,
  title,
  description,
  ogImage,
  ogType = 'website',
  schema,
  localized = true,
  noindex = false,
} = Astro.props;
const t = useTranslations(locale);
const meta = localeMeta[locale];
// Se in Keystatic la tagline è vuota, per Google si usa comunque una frase
// che dice chi è l'artista (titolo "Boleòn — Pittore italiano · …" e
// descrizione): un titolo di sole due parole lasciava indovinare le AI.
const tagline = pickLocalized(settings.taglines, locale) || t('seo.homeTitle');
const pageTitle = title ? `${title} — ${settings.artistName}` : `${settings.artistName} — ${tagline}`;
const pageDescription =
  description ||
  pickLocalized(settings.taglines, locale) ||
  t('seo.artistSummary', { name: settings.artistName });
const bio = pickLocalized(settings.bios, locale);
const year = new Date().getFullYear();

const site = Astro.site ?? new URL('https://boleon.it');
const currentPath = Astro.url.pathname;
const canonical = new URL(currentPath, site);
const alternates = (localized ? locales : []).map((l) => ({
  locale: l,
  hreflang: localeMeta[l].lang,
  href: new URL(switchLocalePath(currentPath, locale, l), site),
}));
const xDefault = new URL(switchLocalePath(currentPath, locale, defaultLocale), site);
const ogImageUrl = ogImage ? new URL(ogImage, site) : undefined;

// Statistiche visite (Umami, senza cookie). L'ID è pubblico (finisce nell'HTML):
// sta qui come default, ma si può sovrascrivere con la variabile di build
// PUBLIC_UMAMI_WEBSITE_ID su Cloudflare.
const umamiWebsiteId =
  import.meta.env.PUBLIC_UMAMI_WEBSITE_ID || '035c3753-0169-4b3e-a1c0-58edbd96fc12';

// Anti-spam Turnstile: lo script si carica solo se è impostata la chiave
// pubblica (variabile di build PUBLIC_TURNSTILE_SITE_KEY su Cloudflare).
const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY;
---

<!doctype html>
<html lang={meta.lang} dir={meta.dir}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f4f0e8" />
    <HandFont />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="description" content={pageDescription} />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>

    <link rel="canonical" href={canonical} />
    {alternates.map((alt) => <link rel="alternate" hreflang={alt.hreflang} href={alt.href} />)}
    {localized && <link rel="alternate" hreflang="x-default" href={xDefault} />}
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />

    <meta property="og:site_name" content={settings.artistName} />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={meta.og} />
    {alternates
      .filter((alt) => alt.locale !== locale)
      .map((alt) => <meta property="og:locale:alternate" content={localeMeta[alt.locale].og} />)}
    {ogImageUrl && <meta property="og:image" content={ogImageUrl} />}
    <meta name="twitter:card" content={ogImageUrl ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    {ogImageUrl && <meta name="twitter:image" content={ogImageUrl} />}

    {schema && <script type="application/ld+json" set:html={JSON.stringify(schema)} />}

    {
      /* Statistiche visite (Umami, senza cookie): attive se l'ID è impostato */
      umamiWebsiteId && (
        <script
          is:inline
          defer
          src="https://cloud.umami.is/script.js"
          data-website-id={umamiWebsiteId}
        />
      )
    }

    {
      /* Anti-spam Turnstile: attivo se è impostata la chiave pubblica */
      turnstileSiteKey && (
        <script
          is:inline
          defer
          src="https://challenges.cloudflare.com/turnstile/v0/api.js"
        />
      )
    }

    <script is:inline define:vars={{ currentLocale: locale, allLocales: localized ? locales : [], defaultLocale }}>
      // Primo accesso della sessione: rispetta la lingua scelta in precedenza
      // (localStorage, impostata dallo switcher) o quella del browser, saltando
      // sulla stessa pagina nella lingua giusta. Guardia anti-loop in sessionStorage.
      try {
        // (allLocales vuoto = pagina senza traduzioni, es. la 404: nessun salto)
        // Mai per motori di ricerca e anteprime: Googlebot visita col browser in
        // inglese, quindi veniva spostato su /en/… da OGNI pagina e Google non
        // indicizzava le versioni italiane (o le vedeva come duplicati).
        var isBot =
          navigator.webdriver ||
          /bot|crawl|spider|slurp|Google-InspectionTool|Mediapartners|APIs-Google|Lighthouse|HeadlessChrome|facebookexternalhit|embedly|preview/i.test(
            navigator.userAgent
          );
        if (!isBot && allLocales.length && !sessionStorage.getItem('boleon-lang-checked')) {
          sessionStorage.setItem('boleon-lang-checked', '1');
          var target = localStorage.getItem('boleon-lang');
          if (allLocales.indexOf(target) < 0) {
            target = null;
            var wanted = navigator.languages || [navigator.language || ''];
            for (var i = 0; i < wanted.length && !target; i++) {
              var code = String(wanted[i]).toLowerCase().split('-')[0];
              if (allLocales.indexOf(code) >= 0) target = code;
            }
          }
          if (target && target !== currentLocale) {
            var path = location.pathname;
            if (currentLocale !== defaultLocale) {
              path = path.replace(new RegExp('^/' + currentLocale + '(?=/|$)'), '') || '/';
            }
            if (target !== defaultLocale) {
              path = '/' + target + (path === '/' ? '' : path);
            }
            location.replace(path + location.search + location.hash);
          }
        }
      } catch (e) {
        /* storage disabilitato: resta nella lingua corrente */
      }
    </script>
  </head>
  <body class="relative flex min-h-screen flex-col antialiased">
    <header class="sticky top-0 z-40 border-b border-neutral-300/50 bg-paper/85 backdrop-blur">
      <div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-5 py-4">
        <a
          href={localizePath(locale, '/')}
          class="font-serif text-4xl leading-none"
        >
          {settings.artistName}
        </a>
        <nav class="flex items-center gap-5 sm:gap-7">
          <a
            href={localizePath(locale, '/')}
            class="hidden text-xs tracking-widest uppercase opacity-70 transition hover:opacity-100 sm:block"
          >
            {t('nav.works')}
          </a>
          <a
            href={localizePath(locale, '/galleria')}
            class="hidden text-xs tracking-widest uppercase opacity-70 transition hover:opacity-100 sm:block"
          >
            {t('nav.gallery')}
          </a>
          <a
            href={localizePath(locale, '/artista')}
            class="hidden text-xs tracking-widest uppercase opacity-70 transition hover:opacity-100 sm:block"
          >
            {t('nav.artist')}
          </a>
          <a
            href={localizePath(locale, '/contatto')}
            class="hidden text-xs tracking-widest uppercase opacity-70 transition hover:opacity-100 sm:block"
          >
            {t('nav.contact')}
          </a>
          <a
            href={localizePath(locale, '/carrello')}
            class="relative flex items-center gap-1.5 text-xs tracking-widest uppercase opacity-70 transition hover:opacity-100"
          >
            <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
              <path d="M5 8h14l-1.2 11.2a1.5 1.5 0 0 1-1.5 1.3H7.7a1.5 1.5 0 0 1-1.5-1.3L5 8Z"></path>
              <path d="M8.5 8V6.5a3.5 3.5 0 0 1 7 0V8"></path>
            </svg>
            <span class="hidden sm:inline">{t('nav.cart')}</span>
            <span
              data-cart-count
              class="absolute -top-2 -end-2 hidden size-4.5 items-center justify-center rounded-full bg-accent text-[0.65rem] font-semibold text-white sm:static sm:size-auto sm:rounded-none sm:bg-transparent sm:text-ink"
            ></span>
          </a>
          <LanguageSwitcher locale={locale} path={localized ? undefined : '/'} />
          <button
            type="button"
            data-menu-toggle
            class="flex size-9 items-center justify-center rounded-sm border border-neutral-400/50 sm:hidden"
            aria-expanded="false"
            aria-controls="mobile-menu"
            aria-label={t('nav.menu')}
          >
            <svg data-menu-icon-open class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
              <path d="M4 7h16M4 12h16M4 17h16"></path>
            </svg>
            <svg data-menu-icon-close class="hidden size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
              <path d="M6 6l12 12M18 6L6 18"></path>
            </svg>
          </button>
        </nav>
      </div>
      <!-- Menu a tendina per il telefono: sui piccoli schermi le voci
           dell'header non ci stanno, quindi si aprono da qui. -->
      <nav id="mobile-menu" class="hidden border-t border-neutral-300/50 sm:hidden">
        <div class="mx-auto flex max-w-6xl flex-col px-5 py-2">
          {
            [
              { href: '/', label: t('nav.works') },
              { href: '/galleria', label: t('nav.gallery') },
              { href: '/artista', label: t('nav.artist') },
              { href: '/contatto', label: t('nav.contact') },
              { href: '/carrello', label: t('nav.cart') },
            ].map((item) => (
              <a
                href={localizePath(locale, item.href)}
                class="border-b border-neutral-300/30 py-3 text-sm tracking-widest uppercase opacity-80 last:border-b-0"
              >
                {item.label}
              </a>
            ))
          }
        </div>
      </nav>
    </header>

    <main class="relative z-10 mx-auto w-full max-w-6xl flex-1 px-5 pt-10 pb-20">
      <slot />
    </main>

    <footer class="relative z-10 border-t border-neutral-300/50">
      <section class="mx-auto max-w-xl px-5 pt-12 text-center" aria-labelledby="newsletter-title">
        <h2 id="newsletter-title" class="font-hand text-2xl">{t('newsletter.title')}</h2>
        <p class="mt-2 text-sm leading-relaxed opacity-70">{t('newsletter.intro')}</p>
        <form
          data-newsletter
          data-locale={locale}
          data-sitekey={turnstileSiteKey ?? ''}
          data-label-submit={t('newsletter.submit')}
          data-label-sending={t('newsletter.sending')}
          data-label-success={t('newsletter.success')}
          data-label-error={t('newsletter.error')}
          data-label-invalid={t('newsletter.invalid')}
          data-label-unavailable={t('newsletter.unavailable')}
          class="mt-5"
        >
          <div data-nl-row class="flex flex-col gap-2 sm:flex-row">
            <input
              data-nl-email
              type="email"
              name="email"
              required
              autocomplete="email"
              placeholder={t('newsletter.placeholder')}
              aria-label={t('newsletter.placeholder')}
              class="min-w-0 flex-1 border border-neutral-300 bg-white/70 px-3 py-2.5 text-sm"
            />
            <button
              type="submit"
              data-nl-submit
              class="paper-btn px-6 py-2.5 text-sm tracking-widest text-white uppercase disabled:cursor-wait disabled:opacity-50"
            >
              {t('newsletter.submit')}
            </button>
          </div>
          {/* Campo trappola per i bot: nascosto alle persone */}
          <input
            name="website"
            data-nl-trap
            tabindex="-1"
            autocomplete="off"
            aria-hidden="true"
            class="sr-only"
          />
          <div data-nl-captcha class="mt-3 flex justify-center empty:hidden"></div>
          <p data-nl-status class="mt-3 hidden text-sm" role="status"></p>
          <p class="mt-3 text-xs leading-relaxed opacity-50">
            {t('newsletter.consent')}
            <a href={localizePath(locale, '/note-legali')} class="underline underline-offset-4">{t('newsletter.privacy')}</a>
          </p>
        </form>
      </section>
      <div class="mx-auto grid max-w-6xl gap-10 px-5 py-12 sm:grid-cols-3">
        <div>
          <p class="font-serif text-lg tracking-[0.3em] uppercase">{settings.artistName}</p>
          {bio && <p class="mt-3 max-w-prose text-sm leading-relaxed opacity-70">{bio}</p>}
        </div>
        <div>
          <p class="text-xs font-semibold tracking-widest uppercase opacity-60">{t('footer.contact')}</p>
          {
            settings.contactEmail && (
              <a href={`mailto:${settings.contactEmail}`} class="mt-3 block text-sm underline-offset-4 hover:underline">
                {settings.contactEmail}
              </a>
            )
          }
          <a
            href={localizePath(locale, '/contatto')}
            class="mt-2 block text-sm underline-offset-4 hover:underline"
          >
            {t('contact.title')}
          </a>
        </div>
        <div>
          <p class="text-xs font-semibold tracking-widest uppercase opacity-60">{t('footer.follow')}</p>
          <div class="mt-3 flex flex-col gap-1 text-sm">
            {settings.instagram && <a href={settings.instagram} rel="noopener" target="_blank" class="underline-offset-4 hover:underline">Instagram</a>}
            {settings.facebook && <a href={settings.facebook} rel="noopener" target="_blank" class="underline-offset-4 hover:underline">Facebook</a>}
          </div>
        </div>
      </div>
      <div class="border-t border-neutral-100 py-4 text-center text-xs opacity-50">
        © {year} {settings.artistName} · {t('footer.rights')} ·
        <a href={localizePath(locale, '/faq')} class="underline-offset-4 hover:underline">{t('footer.faq')}</a> ·
        <a href={localizePath(locale, '/note-legali')} class="underline-offset-4 hover:underline">{t('footer.legal')}</a>
      </div>
    </footer>

    <script>
      import { cartCount } from '../scripts/cart';
      import { initNewsletter } from '../scripts/newsletter';

      function render(count: number) {
        document.querySelectorAll('[data-cart-count]').forEach((el) => {
          el.textContent = count > 0 ? String(count) : '';
          el.classList.toggle('hidden', count === 0);
          el.classList.toggle('flex', count > 0);
        });
      }
      render(cartCount());
      window.addEventListener('cart:updated', (e) => render((e as CustomEvent).detail.count));

      // Apertura/chiusura del menu mobile
      const toggle = document.querySelector('[data-menu-toggle]');
      const menu = document.getElementById('mobile-menu');
      toggle?.addEventListener('click', () => {
        const open = menu?.classList.toggle('hidden') === false;
        toggle.setAttribute('aria-expanded', String(open));
        toggle.querySelector('[data-menu-icon-open]')?.classList.toggle('hidden', open);
        toggle.querySelector('[data-menu-icon-close]')?.classList.toggle('hidden', !open);
      });

      initNewsletter();
    </script>
  </body>
</html>
