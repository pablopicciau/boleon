# Intestazioni di sicurezza servite da Cloudflare su tutte le pagine.
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
  Strict-Transport-Security: max-age=31536000
  X-XSS-Protection: 0
  Content-Security-Policy: base-uri 'self'; object-src 'none'; frame-ancestors 'self'; upgrade-insecure-requests

# File con l'impronta nel nome (font, CSS, JS, immagini ottimizzate da Astro):
# cambiano nome a ogni modifica, quindi il browser può tenerli per un anno
# senza ricontrollarli. Senza questa regola Cloudflare li fa ricontrollare a ogni
# visita e nel frattempo il titolo restava senza il suo font.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

/textures/*
  Cache-Control: public, max-age=604800
